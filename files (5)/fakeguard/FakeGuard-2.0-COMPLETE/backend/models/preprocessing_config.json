{
  "preprocessing": {
    "lowercase": true,
    "remove_extra_whitespace": true
  },
  "vectorization": {
    "type": "TF-IDF",
    "max_features": 5000,
    "min_df": 1,
    "max_df": 0.95,
    "ngram_range": [
      1,
      2
    ],
    "stop_words": "english",
    "norm": "l2"
  },
  "model": {
    "type": "LogisticRegression",
    "max_iter": 1000,
    "solver": "lbfgs"
  }
}